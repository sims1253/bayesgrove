Output tools/demo/repl-workflow/repl-workflow.mp4

Require R

Set Shell "bash"
Set FontSize 20
Set Width 1440
Set Height 920
Set Padding 18
Set Framerate 30
Set PlaybackSpeed 1
Set Theme "GruvboxDark"
Set WindowBar Colorful
Set TypingSpeed 60ms

Type "R --quiet"
Sleep 1s
Enter
Sleep 1s

Type 'source("tools/demo/repl-workflow/launch-demo.R")'
Sleep 1s
Enter
Sleep 5s

Type "status"
Sleep 1s
Enter
Sleep 2s

Type "gates"
Sleep 1s
Enter
Sleep 2s

Type "answer"
Sleep 1s
Enter
Sleep 1s
Type "1"
Sleep 1s
Enter
Sleep 1s
Type "The imbalance is large enough that the adjusted branch should anchor the comparison."
Sleep 1s
Enter
Sleep 2200ms

Type "run"
Sleep 1s
Enter
Sleep 2200ms

Type "status"
Sleep 1s
Enter
Sleep 1800ms

Type "branch node_78dfe7c9"
Sleep 1s
Enter
Sleep 1800ms

Type "status"
Sleep 1s
Enter
Sleep 1800ms

Type "nodes"
Sleep 1s
Enter
Sleep 3s

Type "exit"
Sleep 1s
Enter
Sleep 700ms

Type 'q("no")'
Sleep 1s
Enter
