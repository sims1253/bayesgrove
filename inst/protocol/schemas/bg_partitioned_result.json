{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "bg_partitioned_result.json",
  "title": "bg_partitioned_result",
  "description": "Result from bg_partition_protocol_by_scope()",
  "type": "object",
  "required": ["summary"],
  "properties": {
    "summary": {
      "type": "object",
      "required": ["n_scopes", "n_obligations", "n_actions", "n_blocking", "scopes"],
      "properties": {
        "n_scopes": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of scopes evaluated"
        },
        "n_obligations": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of obligations"
        },
        "n_actions": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of actions"
        },
        "n_blocking": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of blocking obligations"
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of scope identifiers"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": {
    "type": "object",
    "description": "Per-scope partition (scope string as key)",
    "required": ["scope", "scope_label", "obligations", "actions"],
    "properties": {
      "scope": {
        "type": "string",
        "description": "Scope identifier"
      },
      "scope_label": {
        "type": "string",
        "description": "Human-readable scope label"
      },
      "obligations": {
        "type": "object",
        "additionalProperties": { "$ref": "bg_obligation_item.json" }
      },
      "actions": {
        "type": "object",
        "additionalProperties": { "$ref": "bg_action_item.json" }
      }
    },
    "additionalProperties": false
  }
}
