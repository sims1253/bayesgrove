{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "bg_graph_snapshot.json",
  "title": "bg_graph_snapshot",
  "description": "Initial graph snapshot message emitted by bg_serve() on client connect",
  "type": "object",
  "required": [
    "protocol_version",
    "message_type",
    "emitted_at",
    "project_id",
    "project_name",
    "graph",
    "status",
    "pending_gates",
    "branches",
    "branch_goals",
    "protocol",
    "command_surface",
    "extension_registry"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "description": "Wire protocol version"
    },
    "message_type": {
      "type": "string",
      "enum": ["GraphSnapshot"]
    },
    "emitted_at": {
      "type": "string",
      "description": "UTC timestamp when the message was emitted",
      "format": "date-time"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "graph": {
      "type": "object",
      "description": "Current graph document"
    },
    "status": {
      "type": "object",
      "required": [
        "workflow_state",
        "runnable_nodes",
        "blocked_nodes",
        "pending_gates",
        "active_jobs",
        "health",
        "messages"
      ],
      "properties": {
        "workflow_state": {
          "type": "string",
          "enum": ["open", "running", "paused", "degraded", "blocked", "idle"]
        },
        "runnable_nodes": { "type": "integer", "minimum": 0 },
        "blocked_nodes": { "type": "integer", "minimum": 0 },
        "pending_gates": { "type": "integer", "minimum": 0 },
        "active_jobs": { "type": "integer", "minimum": 0 },
        "health": {
          "type": "string",
          "enum": ["ok", "warning", "error"]
        },
        "messages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "last_run_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pending_gates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "edge_id", "prompt", "options", "created_at"],
        "properties": {
          "id": { "type": "string" },
          "edge_id": { "type": "string" },
          "prompt": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "string" }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "branch_id",
          "label",
          "root_node_id",
          "source_node_id",
          "created_at",
          "has_goal",
          "lifecycle"
        ],
        "properties": {
          "branch_id": { "type": "string" },
          "label": { "type": "string" },
          "root_node_id": { "type": "string" },
          "source_node_id": { "type": "string" },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "has_goal": { "type": "boolean" },
          "lifecycle": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "branch_goals": {
      "type": "object",
      "description": "Branch goal registry projection"
    },
    "protocol": {
      "$ref": "bg_partitioned_result.json"
    },
    "command_surface": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["command", "mutates_state", "allowed_args", "required_args"],
        "properties": {
          "command": { "type": "string" },
          "classification": { "type": "string" },
          "description": { "type": "string" },
          "result_message_type": { "type": "string" },
          "mutates_state": { "type": "boolean" },
          "allowed_args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_args": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "extension_registry": {
      "type": "object",
      "required": ["node_kinds", "backends", "workflow_packs", "templates"],
      "properties": {
        "node_kinds": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "backends": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "workflow_packs": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        },
        "templates": {
          "type": "object",
          "additionalProperties": { "$ref": "bg_template_descriptor.json" }
        },
        "policy": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
