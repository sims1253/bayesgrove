{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "bg_template_descriptor.json",
  "title": "bg_template_descriptor",
  "description": "Template descriptor returned by bg_list_templates()",
  "type": "object",
  "required": ["template_ref", "title", "operation_type", "description"],
  "properties": {
    "template_ref": {
      "type": "string",
      "description": "Unique template reference identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable template title"
    },
    "operation_type": {
      "type": "string",
      "enum": ["create_node", "workflow_macro", "record_decision"],
      "description": "Type of operation this template performs"
    },
    "default_label": {
      "type": "string",
      "description": "Default label pattern for created nodes"
    },
    "required_basis": {
      "type": "object",
      "description": "Requirements for using this template",
      "properties": {
        "action_kind": {
          "type": "string",
          "description": "Required action kind"
        },
        "source_node_id": {
          "type": "string",
          "description": "Description of source node requirements"
        },
        "inputs": {
          "type": "string",
          "description": "Description of input requirements"
        },
        "decision_type": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed decision types"
        }
      }
    },
    "parameter_suggestions": {
      "type": "object",
      "description": "Suggested parameters for template execution",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Detailed description of what this template does"
    },
    "read_only": {
      "type": "boolean",
      "description": "Indicates that the descriptor is descriptive-only for clients"
    }
  },
  "additionalProperties": false
}
