{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "bg_protocol_event.json",
  "title": "bg_protocol_event",
  "description": "Incremental protocol event emitted by bg_serve() after state changes",
  "type": "object",
  "required": [
    "protocol_version",
    "message_type",
    "event_id",
    "event_kind",
    "source",
    "emitted_at",
    "status",
    "graph_version"
  ],
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": ["ProtocolEvent"]
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}$"
    },
    "event_kind": {
      "type": "string",
      "enum": ["state_changed"]
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "source": {
      "type": "string"
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "graph_version": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "object",
      "required": [
        "workflow_state",
        "runnable_nodes",
        "blocked_nodes",
        "pending_gates",
        "active_jobs",
        "health",
        "messages"
      ],
      "properties": {
        "workflow_state": {
          "type": "string",
          "enum": ["open", "running", "paused", "degraded", "blocked", "idle"]
        },
        "runnable_nodes": { "type": "integer", "minimum": 0 },
        "blocked_nodes": { "type": "integer", "minimum": 0 },
        "pending_gates": { "type": "integer", "minimum": 0 },
        "active_jobs": { "type": "integer", "minimum": 0 },
        "health": {
          "type": "string",
          "enum": ["ok", "warning", "error"]
        },
        "messages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "last_run_id": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
