{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "bg_command_result.json",
  "title": "bg_command_result",
  "description": "Command result message emitted by bg_serve()",
  "type": "object",
  "required": [
    "protocol_version",
    "message_type",
    "command_id",
    "ok",
    "emitted_at"
  ],
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": ["CommandResult"]
    },
    "command_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "ok": {
      "type": "boolean"
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "description": "Command-specific result payload"
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "expected_protocol_version": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
